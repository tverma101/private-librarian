<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- A source root is always chosen explicitly by the user. Analysis opens
         its files O_RDONLY, while an explicitly confirmed Apply/Undo may move
         files inside the same authorized root. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- Required only for the explicit model-provisioning action in Settings.
         Normal embedding/VLM workers force local/offline loading. No server or
         inbound-network entitlement is present. -->
    <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
